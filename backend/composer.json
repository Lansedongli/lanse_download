{
    "name": "edown/empiredown",
    "description": "帝国下载系统 V3.0 - ThinkPHP 8.1",
    "type": "project",
    "require": {
        "php": ">=8.1.0",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "alipaysdk/easysdk": "^2.2",
        "firebase/php-jwt": "^6.0",
        "topthink/framework": "^8.1",
        "topthink/think-migration": "^3.0",
        "topthink/think-orm": "^3.0",
        "topthink/think-queue": "^3.0",
        "wechatpay/wechatpay": "^1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app",
            "app\\admin\\": "app/admin",
            "app\\api\\": "app/api",
            "app\\common\\": "app/common"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
