APP_NAME = 帝国下载系统
APP_ENV = dev
APP_DEBUG = true

# 数据库
DB_TYPE = mysql
DB_HOST = 127.0.0.1
DB_PORT = 3306
DB_DATABASE = empiredown
DB_USERNAME = edown
DB_PASSWORD = edown_secret
DB_CHARSET = utf8mb4
DB_PREFIX = ed_

# Redis
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_PASSWORD =

# JWT (请使用 openssl rand -base64 64 生成)
JWT_SECRET = ChangeMeToARandomBase64String
JWT_TTL = 7200

# 文件存储
UPLOAD_PATH = /var/www/html/public/uploads
UPLOAD_MAX_SIZE = 104857600

# 缓存驱动 (redis / file)
CACHE_DRIVER = redis
SESSION_DRIVER = redis
